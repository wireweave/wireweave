{
  "name": "@wireweave/markdown-plugin",
  "version": "1.2.11",
  "description": "Markdown plugins for wireweave",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./markdown-it": {
      "import": {
        "types": "./dist/markdown-it.d.ts",
        "default": "./dist/markdown-it.js"
      },
      "require": {
        "types": "./dist/markdown-it.d.cts",
        "default": "./dist/markdown-it.cjs"
      }
    },
    "./marked": {
      "import": {
        "types": "./dist/marked.d.ts",
        "default": "./dist/marked.js"
      },
      "require": {
        "types": "./dist/marked.d.cts",
        "default": "./dist/marked.cjs"
      }
    },
    "./remarkable": {
      "import": {
        "types": "./dist/remarkable.d.ts",
        "default": "./dist/remarkable.js"
      },
      "require": {
        "types": "./dist/remarkable.d.cts",
        "default": "./dist/remarkable.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "publint": "publint --strict",
    "postbuild": "node ../../scripts/dist-freshness-gate.mjs --write ."
  },
  "peerDependencies": {
    "markdown-it": ">=12.0.0",
    "marked": ">=4.0.0",
    "remarkable": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "markdown-it": {
      "optional": true
    },
    "marked": {
      "optional": true
    },
    "remarkable": {
      "optional": true
    }
  },
  "dependencies": {
    "@wireweave/core": "workspace:*"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.2",
    "@types/remarkable": "^2.0.8",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "knip": "^6.35.1",
    "lint-staged": "^16.4.0",
    "markdown-it": "^14.3.2",
    "marked": "^15.0.12",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "remarkable": "^2.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "wireframe",
    "markdown",
    "plugin",
    "markdown-it",
    "marked",
    "remarkable"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wireweave/wireweave.git",
    "directory": "packages/markdown-plugin"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "sideEffects": false
}
