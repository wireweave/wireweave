{
  "name": "@wireweave/cli",
  "version": "0.1.1-beta.12",
  "description": "Wireweave CLI — auth, render, and AI agent for the Wireweave wireframe DSL",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "wireweave": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "postbuild": "node ../../scripts/dist-freshness-gate.mjs --write .",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "publint": "publint --strict"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "dependencies": {
    "@wireweave/sdk": "workspace:*",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "knip": "^6.35.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wireweave/wireweave.git",
    "directory": "packages/cli"
  },
  "homepage": "https://docs.wireweave.org/cli",
  "bugs": {
    "url": "https://github.com/wireweave/wireweave/issues"
  },
  "keywords": [
    "wireweave",
    "cli",
    "wireframe",
    "dsl",
    "ai",
    "agent"
  ],
  "license": "MIT"
}
