{
  "name": "@wireweave/core",
  "version": "3.0.0",
  "description": "Core parser and renderer for wireweave",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./parser": {
      "import": {
        "types": "./dist/parser.d.ts",
        "default": "./dist/parser.js"
      },
      "require": {
        "types": "./dist/parser.d.cts",
        "default": "./dist/parser.cjs"
      }
    },
    "./renderer": {
      "import": {
        "types": "./dist/renderer.d.ts",
        "default": "./dist/renderer.js"
      },
      "require": {
        "types": "./dist/renderer.d.cts",
        "default": "./dist/renderer.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:grammar": "peggy --format es -o src/parser/generated-parser.js src/grammar/wireframe.peggy",
    "postbuild:grammar": "node scripts/format-generated.mjs src/parser/generated-parser.js",
    "build:icons": "node scripts/generate-icons.cjs",
    "build:ts": "tsup",
    "build": "pnpm build:grammar && pnpm build:icons && pnpm build:ts",
    "test": "pnpm test:generators && vitest run",
    "test:generators": "node --test scripts/*.test.mjs",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "postbuild": "node ../../scripts/dist-freshness-gate.mjs --write .",
    "publint": "publint --strict",
    "check:parser-sync": "node scripts/check-generated-parser.mjs",
    "check:icons-sync": "node scripts/generate-icons.cjs --check"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@storybook/html": "^10.6.0",
    "@storybook/html-vite": "^10.6.0",
    "@types/node": "^25.9.6",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "knip": "^6.35.1",
    "lint-staged": "^16.4.0",
    "lucide": "^0.562.0",
    "peggy": "^5.1.0",
    "prettier": "^3.9.6",
    "storybook": "^10.6.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11",
    "publint": "^0.3.24"
  },
  "keywords": [
    "wireframe",
    "dsl",
    "parser",
    "ui",
    "prototyping",
    "design"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wireweave/wireweave.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "sideEffects": false
}
