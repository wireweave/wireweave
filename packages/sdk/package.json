{
  "name": "@wireweave/sdk",
  "version": "0.2.0-beta.15",
  "description": "Wireweave SDK - typed HTTP client, auth, and local tools for the Wireweave API. Sole owner of api-server contract for mcp-server, cli, and skill packages.",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@wireweave/core": "workspace:*",
    "@wireweave/language-data": "workspace:*",
    "@wireweave/ux-rules": "workspace:*"
  },
  "scripts": {
    "build": "tsup",
    "postbuild": "node ../../scripts/dist-freshness-gate.mjs --write .",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "publint": "publint --strict"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.6",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "knip": "^6.35.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wireweave/wireweave.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://docs.wireweave.org",
  "bugs": {
    "url": "https://github.com/wireweave/wireweave/issues"
  },
  "keywords": [
    "wireweave",
    "sdk",
    "client",
    "wireframe",
    "dsl",
    "ai",
    "claude",
    "llm",
    "ui-design"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
