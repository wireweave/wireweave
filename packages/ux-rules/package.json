{
  "name": "@wireweave/ux-rules",
  "version": "1.5.0-beta.12",
  "description": "UX validation rules for wireweave",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsup",
    "postbuild": "node ../../scripts/dist-freshness-gate.mjs --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "release": "release-it",
    "release:beta": "release-it --preRelease=beta",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "publint": "publint --strict"
  },
  "dependencies": {
    "@wireweave/core": "workspace:*"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@release-it/conventional-changelog": "^10.0.4",
    "@types/node": "^22",
    "eslint": "^10.4.0",
    "husky": "^9.1.7",
    "knip": "^6.14.2",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "publint": "^0.3.21",
    "release-it": "^19.2.3",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.60.0",
    "vitest": "^3.1.1"
  },
  "keywords": [
    "wireframe",
    "ux",
    "validation",
    "rules"
  ],
  "author": "Seungwoo Lee",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wireweave/wireweave.git",
    "directory": "packages/ux-rules"
  },
  "bugs": {
    "url": "https://github.com/wireweave/wireweave/issues"
  },
  "homepage": "https://docs.wireweave.org"
}
