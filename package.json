{
  "name": "wireweave-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "author": "Seungwoo Lee <seungwoo321@gmail.com>",
  "homepage": "https://github.com/wireweave/wireweave",
  "repository": {
    "type": "git",
    "url": "https://github.com/wireweave/wireweave.git"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . && pnpm -r run lint",
    "lint:fix": "eslint . --fix && pnpm -r run lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm test:gates && pnpm -r run test",
    "test:gates": "node --test scripts/*.test.mjs",
    "tool-catalog:generate": "node scripts/generate-tool-catalog.mjs --write",
    "tool-catalog:check": "node scripts/generate-tool-catalog.mjs --check",
    "mcp:smoke": "node scripts/mcp-package-smoke.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "dist:check": "node scripts/dist-freshness-gate.mjs --check",
    "tarball:check": "node scripts/packaging-gate.mjs --check-tarballs",
    "sideeffects:check": "node scripts/packaging-gate.mjs --check-side-effects",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,cjs,mjs}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
